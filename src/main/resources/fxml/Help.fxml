<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #2c3e50;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.HelpController">
    <padding>
        <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
    </padding>

    <Label text="Manual de Usuario" textFill="WHITE">
        <font>
            <Font name="System Bold" size="36.0" />
        </font>
        <VBox.margin>
            <Insets bottom="10.0" />
        </VBox.margin>
    </Label>

    <VBox spacing="5.0" style="-fx-background-color: #34495e; -fx-padding: 20; -fx-background-radius: 10;">
        <Label text="¿De qué trata el juego?" textFill="#3498db">
            <font><Font name="System Bold" size="20.0" /></font>
        </Label>
        <Label text="Sokoban es un juego de rompecabezas clasico, en el que eres un trabajador y tu objetivo es empujar todas las cajas" textFill="WHITE" wrapText="true"/>
        <Label text="hasta las zonas de meta, pero ¡Cuidado! Las cajas solo se pueden empujar, no jalar" textFill="WHITE" wrapText="true"/>
        <Label text="Y si las arrinconas contra un muro perderas el nivel" textFill="WHITE" wrapText="true"/>
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: #34495e; -fx-padding: 20; -fx-background-radius: 10;">
        <Label text="Controles de Movimiento:" textFill="#16c79a">
            <font><Font name="System Bold" size="20.0" /></font>
        </Label>
        <Label text="• W o Flecha Arriba: Mover hacia arriba" textFill="WHITE" />
        <Label text="• S o Flecha Abajo: Mover hacia abajo" textFill="WHITE" />
        <Label text="• A o Flecha Izquierda: Mover hacia la izquierda" textFill="WHITE" />
        <Label text="• D o Flecha Derecha: Mover hacia la derecha" textFill="WHITE" />
    </VBox>

    <VBox spacing="10.0" style="-fx-background-color: #34495e; -fx-padding: 20; -fx-background-radius: 10;">
        <Label text="Explicación de Indicadores:" textFill="#f5a623">
            <font><Font name="System Bold" size="20.0" /></font>
        </Label>
        <Label text="• Nivel: Muestra el nivel actual en el que te encuentras." textFill="WHITE" />
        <Label text="• Movimientos: Cuenta cada paso que da tu personaje." textFill="WHITE" />
        <Label text="• Empujes: Cuenta cuántas veces has movido una caja." textFill="WHITE" />
        <Label text="• Cronómetro (⏱): Mide el tiempo exacto desde que iniciaste el nivel." textFill="WHITE" />
    </VBox>

    <Button mnemonicParsing="false" onAction="#handleBack" prefHeight="40.0" prefWidth="150.0" text="Volver al Menú">
        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>
    </Button>
</VBox>